# Local or isolated staging only. Never use mainnet-beta here.
KOTS_RUNTIME_MODE=staging
SOLANA_CLUSTER=devnet
PAID_TAKEOVER_ENABLED=false
AUCTION_SETTLEMENT_ENABLED=false
NFT_MINT_ENABLED=false
KOTS_MECHANICS_ENABLED=false
PUBLIC_CROWN_ARCHIVE_ENABLED=false
CONTENT_SUBMISSIONS_ENABLED=false
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_TREASURY_ADDRESS=DEVNET_PUBLIC_WALLET_ADDRESS
SOLANA_OPERATIONS_VAULT_ADDRESS=DEVNET_PUBLIC_WALLET_ADDRESS

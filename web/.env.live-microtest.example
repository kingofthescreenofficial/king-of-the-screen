# Temporary private mainnet payment test. Do not enable public auction features.
KOTS_RUNTIME_MODE=prelaunch
SOLANA_CLUSTER=mainnet-beta
PAID_TAKEOVER_ENABLED=false
AUCTION_SETTLEMENT_ENABLED=false
NFT_MINT_ENABLED=false
KOTS_MECHANICS_ENABLED=false
LIVE_MICROTEST_ENABLED=true
LIVE_MICROTEST_ACCESS_TOKEN=GENERATE_A_RANDOM_32_BYTE_BASE64URL_TOKEN
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_TREASURY_ADDRESS=MAINNET_TREASURY_PUBLIC_ADDRESS
SOLANA_OPERATIONS_VAULT_ADDRESS=MAINNET_OPERATIONS_PUBLIC_ADDRESS
